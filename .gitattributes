# .gitattributes
#
# Text files are LF everywhere:
# a script checked out with CRLF fails, since python3 and bash read the CR.
* text=auto eol=lf

*.py      text eol=lf diff=python
*.bash    text eol=lf diff=bash
*.bats    text eol=lf diff=bash
*.md      text eol=lf diff=markdown
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.lock    text eol=lf
Makefile  text eol=lf

# GitHub counts the tests as shell code, and the Markdown as documentation.
*.bats    linguist-language=Shell
*.md      linguist-documentation

# git archive drops these, so the tarball of a release holds what a user needs:
# the script, the hooks of pre-commit and the documentation.
.editorconfig            export-ignore
.gitattributes           export-ignore
.github/                 export-ignore
.gitignore               export-ignore
.pre-commit-config.yaml  export-ignore
.python-version          export-ignore
.rumdl.toml              export-ignore
.shellcheckrc            export-ignore
CLAUDE.md                export-ignore
Makefile                 export-ignore
committed.toml           export-ignore
pyproject.toml           export-ignore
tests/                   export-ignore
uv.lock                  export-ignore
