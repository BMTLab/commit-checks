# .editorconfig
#
# One source of formatting truth for editors and for shfmt:
# shfmt reads the shell keys below when it runs without flags.
# Python is formatted by ruff, after pyproject.toml.

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 2

[*.py]
indent_size = 4

[*.{sh,bash}]
shell_variant      = bash
binary_next_line   = true
switch_case_indent = true

[*.bats]
shell_variant      = bats
binary_next_line   = true
switch_case_indent = true

[Makefile]
indent_style = tab
indent_size  = 4
