# tests/.shellcheckrc
#
# ShellCheck reads only the nearest .shellcheckrc,
# so this file repeats the rules of ../.shellcheckrc
# and adds the exceptions that the tests need by design.

shell=bash
external-sources=true
source-path=SCRIPTDIR
# A test sources support/test-helper.bash:
# ShellCheck looks for it in support/ too, so it sees what the module sets.
source-path=SCRIPTDIR/../support
enable=avoid-nullary-conditions
enable=check-unassigned-uppercase
enable=deprecate-which
enable=require-double-brackets
enable=require-variable-braces
enable=quote-safe-variables
# SC2312: a value from $(...) is assigned alone,
# so that a failure of its command is not lost.
enable=check-extra-masked-returns

# SC2030, SC2031: ShellCheck models each @test as a subshell
# and flags the output, status and stderr that bats' `run` sets.
disable=SC2030,SC2031

# SC2154: bats defines output, status, stderr and BATS_* at run time,
# and the test helper declares each CC_ERR_* code by its name.
disable=SC2154
